# Development mode only (see DEVELOPMENT.md). The Docker stack reads the
# .env at the repo root instead.
PORT=5001
DATABASE_URL=postgresql://username:password@localhost:5432/home_kitchen
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Generate your own with: openssl rand -base64 48
JWT_SECRET=change_this_to_a_long_random_secret

# Optional. CLIENT_URL defaults to http://localhost:3000; the rest are
# described in the root .env.example.
CLIENT_URL=
SPOONACULAR_API_KEY=
INSTAGRAM_OEMBED_TOKEN=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
