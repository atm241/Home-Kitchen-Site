{
  "name": "server",
  "version": "1.0.0",
  "description": "Backend server for Home Kitchen Site",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "init-db": "node init-db.js",
    "migrate": "node migrate.js",
    "backfill-expiry": "ts-node src/scripts/backfillExpiry.ts",
    "reset-password": "node reset-password.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "docker start simmer-test-db 2>/dev/null || docker run -d --name simmer-test-db -p 5433:5432 -e POSTGRES_USER=simmer -e POSTGRES_PASSWORD=simmer --tmpfs /var/lib/postgresql/data postgres:16-alpine"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.1",
    "@types/sanitize-html": "^2.16.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.1.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "nodemon": "^3.1.11",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
