# Copy to .env (never commit .env itself)
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=change-me

# Video, photo and receipt imports (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a Meta app token for Instagram's official oEmbed API. Without it,
# Instagram imports are best effort.
INSTAGRAM_OEMBED_TOKEN=

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-too

# Recipe and ingredient-combo recommendations. Free tier is plenty for a
# household: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=...

# The address you actually open the app from — this is the CORS origin, so it
# must match what's in your browser's address bar, not "localhost", or every
# API call is rejected and the app looks broken with no obvious cause.
# Examples: http://192.168.1.50:3000  or  https://kitchen.your-domain.com
CLIENT_URL=http://localhost:3000
