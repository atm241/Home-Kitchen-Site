# Copy to .env (never commit .env itself)
POSTGRES_USER=kitchen
POSTGRES_PASSWORD=change-me

# Video, photo and receipt imports (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: a Meta app token for Instagram's official oEmbed API. Without it,
# Instagram imports are best effort.
INSTAGRAM_OEMBED_TOKEN=

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-too

# Every address you open the app from, separated by commas. This is the CORS
# allow-list: an address missing here gets every API call rejected, and the
# app looks broken with no obvious cause. "localhost" only works on this
# machine itself.
# Example: http://192.168.1.50:3000,https://my-mac.tail1234.ts.net
CLIENT_URL=http://localhost:3000

# ---- Optional ----

# Recipe and ingredient-combo recommendations. They're just empty without
# it. Free tier: https://spoonacular.com/food-api
SPOONACULAR_API_KEY=

# Store-price estimates on the grocery list (Kroger, Smith's, Ralphs, ...).
# Free app at https://developer.kroger.com. See SMITH'S-INTEGRATION.md.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Per-household daily caps on AI imports (defaults 25 / 20 / 30; 0 turns
# one off), and the model used for video imports.
AI_DAILY_LIMIT_VIDEO=
AI_DAILY_LIMIT_PHOTO=
AI_DAILY_LIMIT_RECEIPT=
VIDEO_IMPORT_MODEL=
